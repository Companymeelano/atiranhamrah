<?xml version="1.0" encoding="utf-8"?>
<!-- آیکون M•REPORT — پستهٔ زندهٔ ۲: بازسازی دقیق از تصویر مرجع کاربر.
     نیمه‌های تیرهٔ پوستهٔ باز، بدن کرمی، برگچهٔ سبز سر، چشم‌های غول‌پیکر
     براق، لبخند پهن با زبان، دست‌های سبز تکان‌دهنده و پای سبز —
     بزرگ‌ترین اندازهٔ ممکن در ناحیهٔ امن آیکون تطبیقی (۶۶/۱۰۸)،
     روی اُبسیدین عمیق. عمق فقط با نور و گرادیان، بدون سایه تیره. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- هالهٔ نور گرم پشت پسته -->
    <path android:pathData="M54,55 m-33,0 a33,33 0 1,0 66,0 a33,33 0 1,0 -66,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="55"
                android:gradientRadius="33">
                <item android:offset="0.0" android:color="#52E6CB98" />
                <item android:offset="1.0" android:color="#00E6CB98" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- پسته — بزرگ‌ترین اندازه در ناحیهٔ امن (مقیاس ۰.۷۰ × ۱۰۰ + انتقال ۱۹) -->
    <group
        android:scaleX="0.70"
        android:scaleY="0.70"
        android:translateX="19"
        android:translateY="19">

        <!-- نیمهٔ چپ پوستهٔ تیره -->
        <path android:pathData="M50,12 C36,14 24,24 20,40 C17,52 22,66 34,74 C26,60 27,44 36,32 C42,24 48,18 56,16 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="18"
                    android:startY="12"
                    android:endX="52"
                    android:endY="74">
                    <item android:offset="0.0" android:color="#FF7B3E1E" />
                    <item android:offset="1.0" android:color="#FF4A1F0D" />
                </gradient>
            </aapt:attr>
            <aapt:attr name="android:strokeColor">#FF33150A</aapt:attr>
            <aapt:attr name="android:strokeWidth">1.0</aapt:attr>
        </path>

        <!-- نیمهٔ راست پوستهٔ تیره -->
        <path android:pathData="M50,12 C64,14 76,24 80,40 C83,52 78,66 66,74 C74,60 73,44 64,32 C58,24 52,18 44,16 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="82"
                    android:startY="12"
                    android:endX="48"
                    android:endY="74">
                    <item android:offset="0.0" android:color="#FF6B3418" />
                    <item android:offset="1.0" android:color="#FF3F1B0C" />
                </gradient>
            </aapt:attr>
            <aapt:attr name="android:strokeColor">#FF33150A</aapt:attr>
            <aapt:attr name="android:strokeWidth">1.0</aapt:attr>
        </path>

        <!-- برگچهٔ سبز سر -->
        <path android:pathData="M52,32 C48,26 47,18 51,10 C55,4 61,3 64,6 C60,8 57,13 57,20 C57,25 56,29 54,33 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="58"
                    android:startY="8"
                    android:endX="50"
                    android:endY="34">
                    <item android:offset="0.0" android:color="#FFA9C43C" />
                    <item android:offset="1.0" android:color="#FF6E8F2A" />
                </gradient>
            </aapt:attr>
            <aapt:attr name="android:strokeColor">#FF546E1E</aapt:attr>
            <aapt:attr name="android:strokeWidth">0.8</aapt:attr>
        </path>
        <path
            android:pathData="M53,31 C53,24 54,17 57,11"
            android:strokeColor="#FF546E1E"
            android:strokeWidth="0.8"
            android:strokeLineCap="round" />

        <!-- پاهای سبز -->
        <path
            android:pathData="M43,91 L43,96 M57,91 L57,96"
            android:strokeColor="#FF5C7820"
            android:strokeWidth="7"
            android:strokeLineCap="round" />

        <!-- دست چپ سبز — بالا برده -->
        <path android:pathData="M27,64 C22,58 17,51 13,45">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="27"
                    android:startY="64"
                    android:endX="13"
                    android:endY="45">
                    <item android:offset="0.0" android:color="#FF8FA834" />
                    <item android:offset="1.0" android:color="#FF66831F" />
                </gradient>
            </aapt:attr>
            <aapt:attr name="android:strokeWidth">7</aapt:attr>
            <aapt:attr name="android:strokeLineCap">round</aapt:attr>
        </path>

        <!-- دست راست سبز — بالا برده -->
        <path android:pathData="M73,64 C78,58 83,51 87,45">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="73"
                    android:startY="64"
                    android:endX="87"
                    android:endY="45">
                    <item android:offset="0.0" android:color="#FF8FA834" />
                    <item android:offset="1.0" android:color="#FF66831F" />
                </gradient>
            </aapt:attr>
            <aapt:attr name="android:strokeWidth">7</aapt:attr>
            <aapt:attr name="android:strokeLineCap">round</aapt:attr>
        </path>

        <!-- بدن کرمی — مغز پسته -->
        <path android:pathData="M 19,60 a 31,33 0 1,0 62,0 a 31,33 0 1,0 -62,0 Z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="50"
                    android:startY="22"
                    android:endX="50"
                    android:endY="94">
                    <item android:offset="0.0" android:color="#FFFBF2DA" />
                    <item android:offset="0.55" android:color="#FFEFDCB6" />
                    <item android:offset="1.0" android:color="#FFD9BE93" />
                </gradient>
            </aapt:attr>
            <aapt:attr name="android:strokeColor">#FFC9AC80</aapt:attr>
            <aapt:attr name="android:strokeWidth">1.2</aapt:attr>
        </path>
        <!-- نور نقطه‌ای روی بدن -->
        <path android:pathData="M 26,36 a 12,9 0 1,0 24,0 a 12,9 0 1,0 -24,0 Z" android:fillColor="#55FFFFFF" />

        <!-- لپ‌های نرم -->
        <path android:pathData="M 22.4,66 a 4.6,2.8 0 1,0 9.2,0 a 4.6,2.8 0 1,0 -9.2,0 Z" android:fillColor="#8CF0C9A4" />
        <path android:pathData="M 68.4,66 a 4.6,2.8 0 1,0 9.2,0 a 4.6,2.8 0 1,0 -9.2,0 Z" android:fillColor="#8CF0C9A4" />

        <!-- چشم چپ — غول‌پیکر و براق -->
        <path android:pathData="M 28.2,54 a 8.8,10 0 1,0 17.6,0 a 8.8,10 0 1,0 -17.6,0 Z" android:fillColor="#FF241C10" />
        <path android:pathData="M 31.4,50.8 a 3,3 0 1,0 6,0 a 3,3 0 1,0 -6,0 Z" android:fillColor="#F2FFFFFF" />
        <path android:pathData="M 38.4,57.6 a 1.2,1.2 0 1,0 2.4,0 a 1.2,1.2 0 1,0 -2.4,0 Z" android:fillColor="#A6FFFFFF" />

        <!-- چشم راست — غول‌پیکر و براق -->
        <path android:pathData="M 53.2,55 a 9.8,11 0 1,0 19.6,0 a 9.8,11 0 1,0 -19.6,0 Z" android:fillColor="#FF241C10" />
        <path android:pathData="M 56.7,51.4 a 3.3,3.3 0 1,0 6.6,0 a 3.3,3.3 0 1,0 -6.6,0 Z" android:fillColor="#F2FFFFFF" />
        <path android:pathData="M 64.7,59.2 a 1.3,1.3 0 1,0 2.6,0 a 1.3,1.3 0 1,0 -2.6,0 Z" android:fillColor="#A6FFFFFF" />

        <!-- لبخند پهن + زبان -->
        <path android:pathData="M39,69 Q50,79 61,69 Q50,74 39,69 Z" android:fillColor="#FF241C10" />
        <path android:pathData="M45,73.6 Q50,78 55,73.6 Q50,76.4 45,73.6 Z" android:fillColor="#FFD97C64" />
    </group>
</vector>
