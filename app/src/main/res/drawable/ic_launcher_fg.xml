<?xml version="1.0" encoding="utf-8"?>
<!-- پیش‌زمینه آیکون M•REPORT — مونوگرام M با عمق سه‌بعدی و نقطه برند -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- عمق: سایه M در پشت — افکت سه‌بعدی -->
    <path
        android:pathData="M33.4,70.6 L33.4,42.6 L49.4,58.6 L65.4,42.6 L65.4,70.6"
        android:strokeWidth="7.5"
        android:strokeColor="#66000000"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M74.7,53.4 m-4.75,0 a4.75,4.75 0 1 0 9.5,0 a4.75,4.75 0 1 0 -9.5,0"
        android:fillColor="#66000000" />

    <!-- بدنه M با گرادیان امضای برند (شامپاینی → بنفش → یخ) -->
    <path
        android:pathData="M31,68 L31,40 L47,56 L63,40 L63,68"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="31"
                android:startY="40"
                android:endX="80"
                android:endY="68">
                <item android:offset="0.0" android:color="#FFE8CFA0" />
                <item android:offset="0.5" android:color="#FFB4A0FF" />
                <item android:offset="1.0" android:color="#FF9BD4FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- هسته نور منجمد داخل بدنه M — نور داخل شیشه -->
    <path
        android:pathData="M31,68 L31,40 L47,56 L63,40 L63,68"
        android:strokeWidth="2.2"
        android:strokeColor="#2EFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- نقطه برند (•) با همان گرادیان -->
    <path android:pathData="M72.5,49.25 a4.75,4.75 0 1 0 0,9.5 a4.75,4.75 0 1 0 0,-9.5">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="68"
                android:startY="50"
                android:endX="78"
                android:endY="58">
                <item android:offset="0.0" android:color="#FFE8CFA0" />
                <item android:offset="0.55" android:color="#FFB4A0FF" />
                <item android:offset="1.0" android:color="#FF9BD4FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
