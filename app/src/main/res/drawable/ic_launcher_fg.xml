<?xml version="1.0" encoding="utf-8"?>
<!-- آیکون M•REPORT — M سه‌بعدی چشمگیر با پالت اُبسیدین: بنفش الکتریکی + یخ -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- لایه ۱: دیسک نور پشت M — هاله بنفش الکتریکی -->
    <path android:pathData="M54,34 m-27,0 a27,27 0 1 0 54,0 a27,27 0 1 0 -54,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="34"
                android:gradientRadius="27">
                <item android:offset="0.0" android:color="#3D8A76E8" />
                <item android:offset="1.0" android:color="#008A76E8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- لایه ۲: دیسک نور پشت نقطه برند — هاله یخ -->
    <path android:pathData="M73,54 m-12,0 a12,12 0 1 0 24,0 a12,12 0 1 0 -24,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="73"
                android:centerY="54"
                android:gradientRadius="12">
                <item android:offset="0.0" android:color="#4D9BD4FF" />
                <item android:offset="1.0" android:color="#009BD4FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- لایه ۳: وجه عمق (اکستروژن) — دو پله پایین‌تر برای عمق چندلایه -->
    <path
        android:pathData="M36.2,72.6 L36.2,44.6 L52.2,60.6 L68.2,44.6 L68.2,72.6"
        android:strokeWidth="7.5"
        android:strokeColor="#66110D2E"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M33.6,70.6 L33.6,42.6 L49.6,58.6 L65.6,42.6 L65.6,70.6"
        android:strokeWidth="7.5"
        android:strokeColor="#FF2A2252"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- لایه ۴: بدنه اصلی M — گرادیان اُبسیدین (بنفش یخی → الکتریکی → یخ) -->
    <path
        android:pathData="M31,68 L31,40 L47,56 L63,40 L63,68"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="31"
                android:startY="37"
                android:endX="82"
                android:endY="71">
                <item android:offset="0.0" android:color="#FFF6F2FF" />
                <item android:offset="0.38" android:color="#FFC9BAFF" />
                <item android:offset="0.72" android:color="#FFB4A0FF" />
                <item android:offset="1.0" android:color="#FF9BD4FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- لایه ۵: برجستگی بالایی — نور خوردگی روی شانه M -->
    <path
        android:pathData="M31,44.2 L31,40 L35,44.2"
        android:strokeWidth="2.4"
        android:strokeColor="#B0FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M47,56 L63,40 L63,44.2"
        android:strokeWidth="2.4"
        android:strokeColor="#80FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- هسته نور منجمد — خط نور داخل بدنه -->
    <path
        android:pathData="M31,68 L31,40 L47,56 L63,40 L63,68"
        android:strokeWidth="2"
        android:strokeColor="#2EFFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- لایه ۶: نقطه برند (•) با گرادیان الکتریکی → یخ -->
    <path android:pathData="M72.5,49.25 a4.75,4.75 0 1 0 0,9.5 a4.75,4.75 0 1 0 0,-9.5">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="68"
                android:startY="50"
                android:endX="78"
                android:endY="58">
                <item android:offset="0.0" android:color="#FFD2C6FF" />
                <item android:offset="0.6" android:color="#FFB4A0FF" />
                <item android:offset="1.0" android:color="#FF9BD4FF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- هسته نور نقطه برند -->
    <path
        android:pathData="M72.5,52.1 a1.8,1.8 0 1 0 0,3.6 a1.8,1.8 0 1 0 0,-3.6"
        android:fillColor="#CCEBFFFF" />
    <!-- حلقه ظریف دور نقطه -->
    <path
        android:pathData="M72.5,47.85 a5.65,5.65 0 1 0 0,11.3 a5.65,5.65 0 1 0 0,-11.3"
        android:strokeWidth="0.9"
        android:strokeColor="#599BD4FF"
        android:fillColor="#00000000" />
</vector>
