    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- هاله نور گرم پشت فندق — عمق با نور، نه سایه -->
    <path android:pathData="M54,58 m-34,0 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0">
        <aapt:attr name="android:fillColor">
