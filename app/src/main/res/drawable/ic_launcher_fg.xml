<?xml version="1.0" encoding="utf-8"?>
<!-- پیش‌زمینه آیکون M•REPORT — M سه‌بعدی با پالت اُبسیدین (بنفش الکتریکی + یخ) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- وجه جانبی سه‌بعدی (اکستروژن) — عمق واقعی زیر بدنه -->
    <path
        android:pathData="M33.8,70.8 L33.8,42.8 L49.8,58.8 L65.8,42.8 L65.8,70.8"
        android:strokeWidth="7.5"
        android:strokeColor="#FF241E44"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M75.2,56.8 m-4.75,0 a4.75,4.75 0 1 0 9.5,0 a4.75,4.75 0 1 0 -9.5,0"
        android:fillColor="#FF241E44" />

    <!-- بدنه M — گرادیان اُبسیدین (بنفش روشن → بنفش الکتریکی → یخ) -->
    <path
        android:pathData="M31,68 L31,40 L47,56 L63,40 L63,68"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="31"
                android:startY="38"
                android:endX="80"
                android:endY="70">
                <item android:offset="0.0" android:color="#FFF0EAFF" />
                <item android:offset="0.45" android:color="#FFB4A0FF" />
                <item android:offset="1.0" android:color="#FF9BD4FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- هسته نور منجمد — نور داخل شیشه -->
    <path
        android:pathData="M31,68 L31,40 L47,56 L63,40 L63,68"
        android:strokeWidth="2.2"
        android:strokeColor="#33FFFFFF"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- نقطه برند (•) با گرادیان بنفش → یخ -->
    <path android:pathData="M72.5,49.25 a4.75,4.75 0 1 0 0,9.5 a4.75,4.75 0 1 0 0,-9.5">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="68"
                android:startY="50"
                android:endX="78"
                android:endY="58">
                <item android:offset="0.0" android:color="#FFD2C6FF" />
                <item android:offset="1.0" android:color="#FF9BD4FF" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- هسته نور نقطه -->
    <path
        android:pathData="M72.5,52.3 a1.6,1.6 0 1 0 0,3.2 a1.6,1.6 0 1 0 0,-3.2"
        android:fillColor="#AAFFFFFF" />
</vector>
