            android:fillColor="#E57373" />

        <!-- پاپیون طلایی برند — پایین-وسط، هماهنگ با هویت M•REPORT -->
        <group
            android:scaleX="0.92"
            android:scaleY="0.92"
            android:translateX="4.5"
            android:translateY="7">
