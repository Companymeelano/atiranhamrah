<?xml version="1.0" encoding="utf-8"?>
<!-- آیکون M•REPORT — فندق سه‌بعدی بامزه: بدن گرد قهوه‌ای با گرادیان واقعی،
     کلاهک نمدی موج‌دار با دمگل، چشمک تک‌چشمی، لپ‌های بزرگ گیج، دهان خنده
     با زبان و پاپیون طلایی برند — بزرگ‌ترین اندازه در ناحیه امن،
     روی اُبسیدین عمیق. عمق فقط با نور و گرادیان، بدون سایه تیره. -->
